# Ambiente
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=sua_chave_secreta_muito_segura_aqui
JWT_EXPIRES_IN=7d

# Banco de Dados
# Defina como 'mysql' para usar MySQL ou 'sqlite' para usar SQLite
DB_DIALECT=mysql

# Configurações para MySQL (Ignoradas se DB_DIALECT for sqlite)
DB_HOST=localhost
DB_USER=root
DB_PASS=admin
DB_NAME=corretora_db
DB_PORT=3306

# Configurações para SQLite (Ignoradas se DB_DIALECT for mysql)
DB_STORAGE=./database.sqlite

# Conta inicial do usuário (em R$)
INITIAL_BALANCE=10000.00

# Clock da simulação — hora inicial (minuto 0 = 14:00)
SIMULATION_START_HOUR=14
SIMULATION_START_MINUTE=0
SIMULATION_MAX_MINUTE=59