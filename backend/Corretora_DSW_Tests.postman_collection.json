        {
          "name": "2.1 Visualizar mercado",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/market",
              "host": ["{{baseUrl}}"],
              "path": ["market"]
            }
